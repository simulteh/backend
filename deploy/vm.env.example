# Existing VM root Compose: add env_file: ./backend/.env to service backend.
# Copy this template to backend/.env; fill the empty required values.
# Existing SPRING_DATASOURCE_* in root Compose keep the database connection.

# Generate once: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=''

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=''
SMTP_PASSWORD=''
# Optional; blank uses SMTP_USERNAME.
SMTP_FROM=''
SMTP_STARTTLS=false
SMTP_SSL=true

FRONTEND_URL=https://www.simultech.ru
TEACHER_REQUEST_EMAIL=''
# Optional: WEBSITE_URL=https://your-frontend.example/university

PUBLIC_API_URL=/api
# Enable with the reviewed nginx configuration in deploy/nginx.vm.conf.
FORWARD_HEADERS_STRATEGY=framework

ADMIN_EMAIL=''
ADMIN_PASSWORD=''
SEED_LABS=false
