# Copy to .env on the VM. Fill required empty values; SMTP_FROM is optional.
# Keep passwords in single quotes, especially if they contain $ or #.

# Existing database: keep its current database name, user and password.
POSTGRES_DB=netgenius
POSTGRES_USER=postgres
POSTGRES_PASSWORD=''

# Generate once: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=''

# Mail account and generated SMTP/application password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=''
SMTP_PASSWORD=''
# Empty SMTP_FROM uses SMTP_USERNAME.
SMTP_FROM=''
SMTP_STARTTLS=true
SMTP_SSL=false

# Public frontend URL and recipient for teacher applications.
FRONTEND_URL=https://simulteh.com
TEACHER_REQUEST_EMAIL=''
# Optional: a separate page for the "More details" link in emails.
# WEBSITE_URL=https://simulteh.com

# First administrator. An existing account's password is not overwritten.
ADMIN_EMAIL=''
ADMIN_PASSWORD=''
SEED_LABS=false

# Host port for the API. Use 127.0.0.1 when nginx runs on the same VM.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
